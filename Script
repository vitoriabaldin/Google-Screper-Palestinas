# ============================================================
# FUNÇÕES DE PRÉ-PROCESSAMENTO
# ============================================================
def normalize(text):
    """Lowercase, remove acentos, URLs, pontuação e espaços extras."""
    if not isinstance(text, str):
        return ""
    text = text.lower()
    text = unicodedata.normalize("NFKD", text).encode("ASCII", "ignore").decode("ASCII")
    text = re.sub(r"http\S+", " ", text)
    text = re.sub(r"[^a-z\s]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text
 
 
def tokenize(text, min_len=3):
    """Tokenização + remoção de stopwords + filtro de tamanho mínimo."""
    return [t for t in normalize(text).split()
            if len(t) >= min_len and t not in STOPWORDS_PT]
 
 
def extract_domain(url):
    """Extrai o domínio (sem 'www.') a partir de uma URL."""
    try:
        netloc = urlparse(str(url)).netloc.lower()
        netloc = re.sub(r"^www\.", "", netloc)
        return netloc or "(sem-dominio)"
    except Exception:
        return "(sem-dominio)"
 
 
def safe_sheet(name):
    """Sanitiza nome de aba do Excel (máx. 31 chars, sem caracteres proibidos)."""
    name = re.sub(r"[:\\/?*\[\]]", "_", str(name))
    return name[:31]
 
 
