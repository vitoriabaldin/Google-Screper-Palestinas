def compute_tfidf(corpus, top_n=50, max_features=5000):
    vec = TfidfVectorizer(
        tokenizer=tokenize,
        token_pattern=None,
        lowercase=False,
        max_features=max_features,
    )
    mat = vec.fit_transform(corpus.fillna(""))
    scores = np.asarray(mat.sum(axis=0)).flatten()
    terms = vec.get_feature_names_out()
    return (pd.DataFrame({"termo": terms, "score_tfidf": scores})
              .sort_values("score_tfidf", ascending=False)
              .head(top_n)
              .reset_index(drop=True))
 
