print("[3/7] Calculando vocabulário distintivo por query (log-odds Dirichlet)...")
 
def log_odds_dirichlet(target_counts, other_counts, alpha=0.01, min_total=3):
    n_t = sum(target_counts.values())
    n_o = sum(other_counts.values())
    vocab = set(target_counts) | set(other_counts)
    a0 = alpha * len(vocab)
    results = []
    for w in vocab:
        y_t = target_counts.get(w, 0)
        y_o = other_counts.get(w, 0)
        if y_t + y_o < min_total:
            continue
        num_t = y_t + alpha
        den_t = n_t + a0 - y_t - alpha
        num_o = y_o + alpha
        den_o = n_o + a0 - y_o - alpha
        log_odds = np.log(num_t / den_t) - np.log(num_o / den_o)
        var = 1.0 / (y_t + alpha) + 1.0 / (y_o + alpha)
        z = log_odds / np.sqrt(var)
        results.append((w, y_t, y_o, log_odds, z))
    return pd.DataFrame(results, columns=["termo", "freq_target",
                                          "freq_outras", "log_odds", "z_score"])
 
