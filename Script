# 7.5 Rede de domínios — queries ancoradas em triângulo, domínios via força
plt.figure(figsize=(17, 13))
dom_keep = set(dom_freq[dom_freq["frequencia"] >= 2]["dominio"])
nodes_keep = list(dom_keep) + queries_unique
H = G.subgraph(nodes_keep).copy()
 
anchor_angles = np.linspace(np.pi/2, np.pi/2 + 2*np.pi, len(queries_unique), endpoint=False)
anchor_pos = {q: (3.0*np.cos(a), 3.0*np.sin(a))
              for q, a in zip(sorted(queries_unique), anchor_angles)}
pos = nx.spring_layout(H, pos=anchor_pos, fixed=list(anchor_pos.keys()),
                       k=1.5, seed=42, weight="weight", iterations=200)
 
q_nodes = [n for n in H.nodes if H.nodes[n].get("tipo") == "query"]
d_nodes = [n for n in H.nodes if H.nodes[n].get("tipo") == "dominio"]
d_sizes = [80 + 100 * degree_w.get(n, 1) for n in d_nodes]
edge_widths = [0.3 + 0.7 * H[u][v]["weight"] for u, v in H.edges]
 
nx.draw_networkx_edges(H, pos, alpha=0.22, width=edge_widths)
nx.draw_networkx_nodes(H, pos, nodelist=d_nodes, node_size=d_sizes,
                       node_color="#4878A6", alpha=0.75,
                       edgecolors="white", linewidths=0.5)
nx.draw_networkx_nodes(H, pos, nodelist=q_nodes, node_size=3000,
                       node_color="#C44E52", alpha=0.92,
                       edgecolors="white", linewidths=1.8)
# Rótulos das queries deslocados radialmente para fora
q_label_pos = {}
